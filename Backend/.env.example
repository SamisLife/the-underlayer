# The Underlayer — environment template
# Copy this file to .env and fill in your values.
# SSH credentials belong in data/hosts.json, NOT here.

# ── Google Gemini (optional — personalized AI explanations & analysis) ─────────
# Without a key, /api/learn still explains well-known ports and threat-analysis
# metrics from the built-in offline knowledge base.
GOOGLE_API_KEY=

# ── SSH connection defaults ───────────────────────────────────────────────────
SSH_PORT=22
SSH_TIMEOUT=10
CMD_TIMEOUT=15
