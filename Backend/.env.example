# The Underlayer — environment template
# Copy this file to .env and fill in your values.
# SSH credentials belong in data/hosts.json, NOT here.

# ── MongoDB (required by app.py) ──────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=underlayer

# ── DigitalOcean AI inference (optional — used by app.py AI commentary) ───────
DO_AI_API_KEY=
DO_AI_MODEL=openai-gpt-oss-120b

# ── SSH Engine connection to relay (app.py) ───────────────────────────────────
RELAY_URL=http://localhost:8000

# ── SSH connection defaults ───────────────────────────────────────────────────
SSH_PORT=22
SSH_TIMEOUT=10
CMD_TIMEOUT=15
