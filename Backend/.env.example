# The Underlayer — environment template
# Copy this file to .env and fill in your values.
# SSH credentials belong in data/hosts.json, NOT here.

# ── Storage (optional) ────────────────────────────────────────────────────────
# Leave MONGO_URI unset to run with an in-memory store — zero setup, data lives
# until restart. Set it to persist to MongoDB (Atlas or a local mongod).
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGO_DB=underlayer

# ── Google Gemini (optional — personalized AI explanations & analysis) ─────────
# Without a key, /api/learn still explains well-known ports and threat-analysis
# metrics from the built-in offline knowledge base.
GOOGLE_API_KEY=

# ── SSH connection defaults ───────────────────────────────────────────────────
SSH_PORT=22
SSH_TIMEOUT=10
CMD_TIMEOUT=15
