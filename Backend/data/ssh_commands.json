{
  "version": "1.0.0",
  "commands": {
    "os_release":        "cat /etc/os-release 2>/dev/null",
    "kernel":            "uname -r 2>/dev/null",
    "arch":              "uname -m 2>/dev/null",
    "cpu_info":          "grep -m1 'model name' /proc/cpuinfo 2>/dev/null",
    "cpu_cores":         "nproc 2>/dev/null",
    "memory_mb":         "awk '/^MemTotal/ {printf \"%d\", $2/1024}' /proc/meminfo 2>/dev/null",
    "users":             "getent passwd 2>/dev/null | awk -F: '$3 >= 0 && $3 <= 60000 {print $1 \" \" $3}'",
    "sudo_version":      "sudo --version 2>/dev/null | head -1",
    "ssh_version":       "ssh -V 2>&1 | head -1",
    "apt_packages":      "dpkg-query -W -f='${Package} ${Version}\\n' 2>/dev/null | head -200",
    "python_version":    "python3 --version 2>&1 || python --version 2>&1 || echo ''",
    "python_packages":   "pip3 list --format=json 2>/dev/null || pip list --format=json 2>/dev/null || echo '[]'",
    "node_version":      "node --version 2>/dev/null || nodejs --version 2>/dev/null || echo ''",
    "node_packages":     "npm list -g --json --depth=0 2>/dev/null || echo '{}'",
    "java_version":      "java -version 2>&1 | head -1 || echo ''",
    "docker_version":    "docker --version 2>/dev/null || echo ''",
    "docker_images":     "docker images --format '{{.Repository}}\\t{{.Tag}}' 2>/dev/null || echo ''",
    "docker_containers": "docker ps --format '{{.Names}}\\t{{.Image}}\\t{{.Status}}' 2>/dev/null || echo ''",
    "services":          "systemctl list-units --type=service --state=active --no-pager --no-legend 2>/dev/null | awk '{print $1}'",
    "open_ports":        "ss -tlnp 2>/dev/null | tail -n +2 || netstat -tlnp 2>/dev/null | tail -n +3",
    "nginx_version":     "nginx -v 2>&1 || echo ''",
    "apache_version":    "apache2 -v 2>/dev/null | head -1 || httpd -v 2>/dev/null | head -1 || echo ''",
    "postgresql_ver":    "psql --version 2>/dev/null | head -1 || echo ''",
    "mysql_ver":         "mysql --version 2>/dev/null | head -1 || echo ''",
    "mongodb_ver":       "mongod --version 2>/dev/null | head -1 || mongosh --version 2>/dev/null | head -1 || echo ''",
    "redis_ver":         "redis-server --version 2>/dev/null | head -1 || echo ''",
    "suid_binaries":     "find /usr/bin /usr/sbin /bin /sbin -perm -4000 -type f 2>/dev/null",
    "apt_upgradable":    "apt list --upgradable 2>/dev/null | tail -n +2",
    "k8s_version":       "kubectl version --client --short 2>/dev/null | head -1 || kubectl version --client 2>/dev/null | head -1 || echo ''",
    "virt_detect":       "systemd-detect-virt 2>/dev/null || echo 'unknown'",
    "cloud_aws":         "curl -sf --connect-timeout 1 http://169.254.169.254/latest/meta-data/ 2>/dev/null && echo 'aws' || echo ''",
    "cloud_gcp":         "curl -sf --connect-timeout 1 -H 'Metadata-Flavor: Google' http://metadata.google.internal/ 2>/dev/null && echo 'gcp' || echo ''",
    "cloud_azure":       "curl -sf --connect-timeout 1 'http://169.254.169.254/metadata/instance?api-version=2021-02-01' -H 'Metadata: true' 2>/dev/null && echo 'azure' || echo ''"
  }
}
