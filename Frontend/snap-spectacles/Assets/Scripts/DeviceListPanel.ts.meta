  InputLines:
    - '// @input SceneObject cameraRoot {"hint":"Optional. Assign the Camera Object to copy its render layer."}'
    - '// @input string websocketUrl = "ws://10.0.0.131:8000/ws/devices" {"hint":"URL for the WebSocket backend (e.g. ws://10.0.0.131:8000/ws/devices or wss://tunnel.cloudflare.com/ws/devices)"}'
    - '// @input Asset.Font hudFont {"hint":"Optional monospace font for all console labels."}'
    - '// @input Asset.ObjectPrefab phonePrefab {"hint":"Prefab for a Phone device (with hacker material)"}'
    - '// @input Asset.ObjectPrefab laptopPrefab {"hint":"Prefab for a Laptop device (with hacker material)"}'
    - '// @input Asset.ObjectPrefab routerPrefab {"hint":"Prefab for a Router device (with hacker material)"}'
    - '// @input Asset.ObjectPrefab indicatorPrefab {"hint":"Prefab for the device indicator (e.g. 3D discord server mesh)."}'
    - '// @input Asset.ObjectPrefab tripleMonitorPrefab {"hint":"Prefab for the Triple Monitor 3D UI."}'
    - '// @input float centerUIScale = 0.2 {"hint":"Scale multiplier for Center Monitor UI (default 0.2)"}'
    - '// @input vec3 centerUIOffset = {0,0,0} {"hint":"Pos Offset for Center Monitor UI"}'
    - '// @input vec3 centerUIRot = {0,0,0} {"hint":"Rot Offset for Center Monitor UI (Degrees)"}'
    - '// @input float leftUIScale = 0.2 {"hint":"Scale multiplier for Left Monitor UI (default 0.2)"}'
    - '// @input vec3 leftUIOffset = {0,0,0} {"hint":"Pos Offset for Left Monitor UI"}'
    - '// @input vec3 leftUIRot = {0,0,0} {"hint":"Rot Offset for Left Monitor UI (Degrees)"}'
    - '// @input float rightUIScale = 0.2 {"hint":"Scale multiplier for Right Monitor UI (default 0.2)"}'
    - '// @input vec3 rightUIOffset = {0,0,0} {"hint":"Pos Offset for Right Monitor UI"}'
    - '// @input vec3 rightUIRot = {0,0,0} {"hint":"Rot Offset for Right Monitor UI (Degrees)"}'
    - '// @input float indicatorScale = 1 {"hint":"Scale multiplier for the indicator prefab"}'
    - '// @input Component.AudioComponent loadedAudio {"hint":"Sound when devices finish loading from API"}'
    - '// @input Component.AudioComponent selectAudio {"hint":"Sound when clicking a device card"}'
    - '// @input Component.AudioComponent anchorAudio {"hint":"Sound when device is anchored"}'
    - '// @input Component.AudioComponent openAudio {"hint":"Sound when opening the device monitors"}'
    - '// @input Component.AudioComponent analyzeAudio {"hint":"Looping sound when analyzing"}'
    - '// @input Asset.Material indicatorMaterial {"hint":"Optional material (like Hologram.mat) to apply to the indicator for a glowing effect."}'
    - '// @input float modelScale = 0.2 {"hint":"Scale multiplier to size the 3D models down to fit the cell"}'
    - '// @input float modelOffsetY = 1.5 {"hint":"Y-axis offset to center models vertically in their cell"}'
    - '// @input float modelOffsetZ = 4 {"hint":"Z-axis offset to push models forward out of the screen"}'
    - // @input Asset.ObjectPrefab shellTerminalPrefab
    - '// @input float shellTerminalScale = 0.02 {"hint":"Scale multiplier for the shell terminal (default 0.02)"}'
    - '// @input vec3 shellTerminalOffset = {-15,-8,0} {"hint":"Local position offset for the shell terminal"}'
    - // @input Asset.ObjectPrefab notebookPrefab
    - '// @input float notebookScale = 0.16 {"hint":"Scale multiplier for the notebook (default 0.16)"}'
    - '// @input vec3 notebookOffset = {-15,-8,0} {"hint":"Local position offset for the notebook"}'
    - '// @input vec3 notebookTitlePos = {-3.5,17.5,2} {"hint":"Local position for notebook Title"}'
    - '// @input vec3 notebookTextPos = {-4,-27,2} {"hint":"Local position for notebook Body text"}'
    - '// @input vec3 notebookCloseBtnPos = {-16,17.5,2} {"hint":"Local position for notebook Close Button"}'
